# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Local environment files / secrets — never commit these
.env
.env.local
*.local

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# macOS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Impeccable: ephemeral working state (review screenshots, decision-page
# sessions, hook cache) — config.json and design.json are the durable
# artifacts and stay tracked.
.impeccable/review/
.impeccable/questions/
.impeccable/hook.cache.json
